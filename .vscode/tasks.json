{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mihomo: build",
      "type": "shell",
      "command": "mkdir -p \"${workspaceFolder}/bin\" && CGO_ENABLED=0 go build -tags with_gvisor -trimpath -o \"${workspaceFolder}/bin/mihomo\" .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    }
  ]
}
